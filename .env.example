# ── Dadnovin stack ────────────────────────────────────────────────
# Copy to .env and fill in. Never commit the real .env.

# PostgreSQL (container-internal only — not exposed publicly)
POSTGRES_USER=dadnovin
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=dadnovin

# FastAPI — generate with: openssl rand -hex 32
SECRET_KEY=replace-with-64-hex-chars
ENVIRONMENT=development

# Session cookie — set true ONLY behind HTTPS
COOKIE_SECURE=false

# Origins allowed to call the API (comma-separated).
# Local gateway serves everything same-origin on :8080.
CORS_ORIGINS=http://localhost:8080

# Public HTTP port for the gateway
HTTP_PORT=8080

# First-run admin bootstrap (optional; empty = skip, use CLI instead)
# docker compose exec api python -m main.cli bootstrap-admin \
#   --username admin --password 'long-secret' --name 'نام مدیر'
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=admin123
BOOTSTRAP_ADMIN_NAME=مدیر مجموعه

# AI consultant — OpenAI-compatible provider.
# Empty AI_API_KEY = assistant runs in retrieval-only "unavailable" mode.
AI_ENABLED=true
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Bank-data encryption (payout card/IBAN, AES-256-GCM).
# Optional dedicated key — falls back to an HKDF of SECRET_KEY.
# Set this once in production; rotating it invalidates stored ciphertext.
# Generate with: openssl rand -hex 32
PAYOUT_ENC_KEY=

# Absolute site origin — embedded in referral links / QR codes
PUBLIC_BASE_URL=http://localhost:8080

# Seed demo content on container boot (dev convenience — keep OFF in prod)
SEED_ON_BOOT=false

# OpenAPI docs at /docs + /openapi.json — disabled automatically by prod compose
EXPOSE_DOCS=true

# Dev override (docker-compose.dev.yml): 1 = uvicorn --reload inside api
#UVICORN_RELOAD=1

# Production only
UVICORN_WORKERS=1
